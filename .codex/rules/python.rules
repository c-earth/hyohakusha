# Project-venv interpreter approval, explicitly requested by the user.
# Loaded at startup only when the project configuration layer is trusted.
# Covers all interpreter arguments; task authorization remains separate,
# including the user's requirement for explicit additional-package permission.

prefix_rule(
    pattern = [".venv\\Scripts\\python.exe"],
    decision = "allow",
    match = [
        "'.venv\\Scripts\\python.exe' ./src/agent/assess_calibration.py",
        "'.venv\\Scripts\\python.exe' -m pip check",
    ],
    not_match = [
        "python ./src/agent/assess_calibration.py",
        "tools/esptool/python.exe ./src/agent/assess_calibration.py",
    ],
)
